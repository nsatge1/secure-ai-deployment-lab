# Template for .env. Copy with `make env`, then replace every CHANGE_ME.
# This file is committed: it must only contain variable NAMES and placeholders.
# Generate strong values with: openssl rand -base64 32

# --- PostgreSQL / pgvector (step 2) ---
POSTGRES_DB=ragdb
# Admin account: used only for initialisation, never by the API.
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=CHANGE_ME
# Least-privilege roles: the API reads, ingestion writes.
DB_READER_PASSWORD=CHANGE_ME
DB_INGEST_PASSWORD=CHANGE_ME

# --- API access (step 7) ---
# Key clients send in a request header. Never reuse it elsewhere.
API_KEY=CHANGE_ME
